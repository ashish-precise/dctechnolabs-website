const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "LinkedIn Ads Management",
      "provider": { "@type": "LocalBusiness", "name": "DC technolabs", "telephone": "+919662608986" },
      "areaServed": { "@type": "City", "name": "Ahmedabad" },
      "description": "LinkedIn Ads management for B2B and IT companies in Ahmedabad and GIFT City. Sponsored Content, InMail, and Lead Gen Forms built to reach decision-makers directly.",
      "offers": { "@type": "Offer", "priceCurrency": "INR", "price": "35000" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Why is LinkedIn Ads more expensive than Facebook or Instagram Ads?", "acceptedAnswer": { "@type": "Answer", "text": "LinkedIn's cost per click is higher because you are paying to reach a professional audience by job title, company, and seniority rather than general interest. For B2B and enterprise sales, the quality of the lead usually justifies the higher cost per click." } },
        { "@type": "Question", "name": "What is a good budget to start with on LinkedIn Ads?", "acceptedAnswer": { "@type": "Answer", "text": "We recommend a minimum of Rs. 40,000 per month in ad spend, paid directly to LinkedIn. Budgets below that struggle to generate enough impressions for reliable targeting data, especially for niche B2B audiences." } },
        { "@type": "Question", "name": "What is a Lead Gen Form on LinkedIn?", "acceptedAnswer": { "@type": "Answer", "text": "A Lead Gen Form is a native LinkedIn ad format where a prospect's profile details, name, email, job title, and company, are pre-filled automatically. This removes friction from the sign-up and typically improves conversion rates compared to sending traffic to an external landing page." } },
        { "@type": "Question", "name": "Is LinkedIn Ads worth it for a small or mid-size company?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, if your buyer is a business decision-maker rather than a consumer. IT services, SaaS, consulting, manufacturing, and B2B companies in GIFT City and across Ahmedabad see strong results because LinkedIn lets you target by exact job title and company size." } },
        { "@type": "Question", "name": "How long before LinkedIn Ads start producing leads?", "acceptedAnswer": { "@type": "Answer", "text": "Sponsored Content campaigns typically start generating impressions and clicks within 24 to 48 hours. B2B sales cycles are longer than consumer purchases, so we track both immediate Lead Gen Form submissions and longer-term engagement from target accounts." } }
      ]
    }
  ]
});

