    title: "Pipeline-Focused Reporting",
    desc: "Monthly reporting on cost per lead, Lead Gen Form conversion rate, and which job titles and industries are engaging, not just clicks and impressions."
  },
];

const problemCards: ProblemCard[] = [
  { problem: "We are getting clicks on LinkedIn but no real leads", solution: "Sending clicks to a slow external landing page loses B2B prospects fast. We use native Lead Gen Forms that pre-fill profile data, which typically lifts conversion rates significantly over external pages." },
