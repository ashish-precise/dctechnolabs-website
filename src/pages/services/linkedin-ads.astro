const faqItems: FaqItem[] = [
  { q: "Why is LinkedIn Ads more expensive than Facebook or Instagram Ads?", a: "LinkedIn's cost per click is higher because you are paying to reach a professional audience by job title, company, and seniority rather than general interest. For B2B and enterprise sales, the quality of the lead usually justifies the higher cost per click." },
  { q: "What is a good budget to start with?", a: "We recommend a minimum of ₹40,000 per month in ad spend, paid directly to LinkedIn. Budgets below that struggle to generate enough impressions for reliable targeting data, especially for niche B2B audiences." },
