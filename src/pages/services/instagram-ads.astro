---
import ServicePageLayout from '../../layouts/ServicePageLayout.astro';
import type {
  FeatureCard, ProblemCard, ProcessStep, Deliverable,
  ComparisonRow, PricingTier, PortfolioCard, Testimonial,
  FaqItem, RelatedService
} from '../../layouts/ServicePageLayout.astro';

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Instagram Ads Management",
      "provider": { "@type": "LocalBusiness", "name": "DC technolabs", "telephone": "+919662608986" },
      "areaServed": { "@type": "City", "name": "Ahmedabad" },
      "description": "Instagram Ads management for Ahmedabad businesses. Feed, Story, and Reels campaigns with creative testing and audience targeting built for Gujarat's shopping and service audience.",
      "offers": { "@type": "Offer", "priceCurrency": "INR", "price": "25000" }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "How much budget do I need for Instagram Ads?", "acceptedAnswer": { "@type": "Answer", "text": "We recommend a minimum ad spend of Rs. 20,000 per month, paid directly to Meta. This is separate from our management fee and gives enough volume to test creatives and find your best-performing audience." } },
        { "@type": "Question", "name": "How is Instagram Ads different from your social media marketing service?", "acceptedAnswer": { "@type": "Answer", "text": "Our social media marketing service covers organic content, posting, and community management. This service is dedicated paid advertising on Instagram, that is, Feed, Story, and Reels ads with a media budget, built for lead generation and sales rather than general brand presence." } },
        { "@type": "Question", "name": "Do you create the ad creatives or do I need to provide them?", "acceptedAnswer": { "@type": "Answer", "text": "We design and edit all ad creatives including static images, carousels, and short-form Reels ads. If you have existing product photos or videos we use those, otherwise our team shoots and edits new creative for the campaign." } },
        { "@type": "Question", "name": "How quickly can Instagram Ads start generating leads?", "acceptedAnswer": { "@type": "Answer", "text": "Campaigns can go live within 3 to 5 business days including creative production and audience setup. Meta's algorithm typically needs 5 to 7 days of learning phase after launch before performance stabilises." } },
        { "@type": "Question", "name": "Do you manage Facebook Ads along with Instagram?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Instagram and Facebook share the same Meta Ads Manager and audience pool, so every campaign we build runs across both placements by default unless you want Instagram-only creative for a specific launch." } }
      ]
    }
  ]
});

