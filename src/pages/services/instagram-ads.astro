const faqItems: FaqItem[] = [
  { q: "How much budget do I need for Instagram Ads?", a: "We recommend a minimum ad spend of ₹20,000 per month, paid directly to Meta. This is separate from our management fee and gives enough volume to test creatives and find your best-performing audience." },
  { q: "How is this different from your social media marketing service?", a: "Our social media marketing service covers organic content, posting, and community management. This service is dedicated paid advertising, that is, Feed, Story, and Reels ads with a media budget, built for lead generation and sales." },
  { q: "Do you create the ad creatives?", a: "Yes. We design and edit all ad creatives including static images, carousels, and short-form Reels ads. If you have existing product photos or videos we use those, otherwise our team shoots and edits new creative." },
  { q: "How quickly can campaigns start generating leads?", a: "Campaigns can go live within 3 to 5 business days including creative production and audience setup. Meta's algorithm typically needs 5 to 7 days of learning phase after launch before performance stabilises." },
