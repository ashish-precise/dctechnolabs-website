    iconPath: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>`,
    title: "Performance Reporting",
    desc: "Monthly reports on reach, cost per result, click-through rate, and return on ad spend, mapped clearly to the leads or sales the campaign actually produced."
  },
];

const problemCards: ProblemCard[] = [
  { problem: "We boosted a few posts but got no real leads", solution: "Boosted posts optimise for likes, not leads. We build dedicated campaigns with the right objective (leads, messages, or purchases) and a proper Meta Pixel and Conversions API setup so Instagram actually optimises for results that matter." },
  { problem: "Our ad creative feels like an ad and gets ignored", solution: "We design creative that matches native Instagram content style, Reels-first and caption-led, so it earns attention instead of getting scrolled past." },
  { problem: "Our cost per result keeps climbing every month", solution: "Ad fatigue sets in when the same creative runs too long. We rotate 4 to 6 fresh creative variations monthly and rebuild audiences before performance drops." },
  { problem: "We do not know who is actually seeing our ads", solution: "Vague 'everyone in Ahmedabad' targeting wastes budget on people who will never buy. We build layered audiences from interests, past customers, and website visitors." },
  { problem: "We tried running ads ourselves and the budget disappeared fast", solution: "Self-managed campaigns often default to broad reach instead of conversion-focused delivery. Expert setup with correct event tracking typically cuts wasted spend significantly in the first month alone." },
  { problem: "Our competitors seem to be everywhere on Instagram and we are nowhere", solution: "Consistent paid presence compounds. We build always-on campaigns at a sustainable budget so your brand shows up as often as, or more than, your competitors." },
];

