  { feature: "Reels-first ad strategy",               us: "✓", usClass: "check", agency: "Rarely",       agencyClass: "cross", freelancer: "Varies",  freelancerClass: "cross" },
  { feature: "Transparent spend reporting",           us: "✓", usClass: "check", agency: "Summary only", agencyClass: "cross", freelancer: "Varies",  freelancerClass: "cross" },
